# Environment -- never commit real keys
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# NOTE: .secrets.baseline is intentionally NOT ignored. detect-secrets
# baselines are meant to be committed -- the pre-commit hook is configured
# with --baseline .secrets.baseline and fails on a fresh clone without it.
nul

# VS Code Local History
.history/

# Windows Explorer folder settings
desktop.ini

# Benchmark corpus checkouts (transient, re-fetched by bench/run.py)
bench/.cache/

# Raw benchmark reports: ~56MB of derived data. The corpus is SHA-pinned, so
# `python bench/run.py` regenerates them byte-for-byte. They must exist locally
# for bench/score.py to quote false positives verbatim -- they just don't need
# to live in git history. Drop these two lines if you want them committed.
bench/results/*.json
bench/results/*.sarif
bench/results-audit/*.json

# aisafe audit artefacts written by the skill flow (before/after documents,
# baseline drafts). The walk still reads them: evaluation reports there count
# as evidence, and the audit's own documents are skipped by content.
.aisafe-audit/
.aisg-audit/

# aisafe fleet documents and per-repository reports (derived; regenerated by the run).
.aisafe-fleet/
.aisg-fleet/

# The default output of a bare `aisafe evaluate` run from the repository root. A
# committed copy would be read by the next self-audit as evidence about this
# repository, which it is not; keep evaluation reports with the system they evaluated.
# The second name is the one the command wrote before it was renamed; the audit still
# reads it.
/evaluation-report.json
/probe-report.json

# The score of the synthetic corpus (`bench/score.py --cases bench/cases`): derived from
# the cases and the detector, regenerated on demand, never a source.
/bench/cases-score.md

# Bench and research clones (bench/run.py --keep-clones); never source of this repo
/bench/.cache/

# Working files of the research sweep (salvaged agent output, the queue skeptics read);
# the consolidated record is research/results/sweep/corpus-sweep.json
/research/results/sweep/_*

# Review console data, rebuilt by research/console/console.py build; it quotes other
# repositories' code, so it is published with the console and never committed
/research/console/build/
